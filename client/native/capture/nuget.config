<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка не должна зависеть от настроек NuGet конкретного ПК: несуществующий локальный источник
  или резервная папка (ошибка NU1301), сопоставление пакетов с недоступным источником (NU1100)
  ломают восстановление, хотя все нужные пакеты есть на nuget.org. Поэтому всё это сбрасываем.
  Папку кэша пакетов (globalPackagesFolder) здесь не задать без потери общего кэша — её
  недоступность обходит scripts/build-native.mjs.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>

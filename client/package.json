{
  "name": "duostream",
  "productName": "DuoStream",
  "version": "1.1.0",
  "private": true,
  "description": "P2P-стрим экрана и голосовой чат на двоих: WebRTC, AV1/NVENC, шумодав на ONNX Runtime",
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs && node scripts/build-native.mjs --optional",
    "start": "electron .",
    "start:viewer": "electron . --profile=viewer",
    "build:native": "node scripts/build-native.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "test:denoiser": "node scripts/test-denoiser.mjs",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "onnxruntime-web": "^1.30.0"
  },
  "allowScripts": {
    "electron": true
  },
  "build": {
    "appId": "local.duostream.app",
    "productName": "DuoStream",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "config/stream.config.default.json",
      "package.json",
      {
        "from": "../server/src",
        "to": "server",
        "filter": [
          "*.js"
        ]
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "package.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "duostream-capture.exe"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "urjoonneighbor",
        "repo": "duostream",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DuoStream",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  }
}

{
  "name": "duostream",
  "productName": "DuoStream",
  "version": "1.1.0",
  "private": true,
  "description": "P2P-стрим экрана и голосовой чат на двоих: WebRTC, AV1/NVENC, шумодав на ONNX Runtime",
  "main": "app/main/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-ort.mts && node scripts/build-native.mts --optional",
    "build": "node -e \"require('fs').rmSync('app',{recursive:true,force:true})\" && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.worklet.json && npm --prefix ../server run build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.worklet.json --noEmit && tsc -p tsconfig.scripts.json",
    "prestart": "npm run build",
    "start": "electron .",
    "prestart:viewer": "npm run build",
    "start:viewer": "electron . --profile=viewer",
    "build:native": "node scripts/build-native.mts",
    "fetch-models": "node scripts/fetch-models.mts",
    "test:denoiser": "node scripts/test-denoiser.mts",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "onnxruntime-web": "^1.30.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron": true
  },
  "build": {
    "appId": "local.duostream.app",
    "productName": "DuoStream",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "files": [
      "app/**/*",
      "src/renderer/**/*",
      "!src/renderer/**/*.ts",
      "!src/renderer/**/*.d.mts",
      "config/stream.config.default.json",
      "package.json",
      {
        "from": "../server/dist",
        "to": "server",
        "filter": [
          "*.js"
        ]
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "package.json"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "duostream-capture.exe"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "urjoonneighbor",
        "repo": "duostream",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DuoStream",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.0"
  }
}

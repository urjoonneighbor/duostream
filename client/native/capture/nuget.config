<?xml version="1.0" encoding="utf-8"?>
<!--
  Только nuget.org. <clear /> отключает источники пакетов из глобальных настроек NuGet этого ПК:
  иначе один несуществующий локальный источник (ошибка NU1301) ломает сборку, хотя все нужные
  пакеты есть на nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

{
  "name": "duostream-signaling",
  "version": "1.0.0",
  "private": true,
  "description": "Минимальный WebSocket-сервер сигнализации DuoStream: только SDP и ICE, медиа через него не идёт",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.test.json && node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
